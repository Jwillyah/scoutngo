# Copy to .env and fill in your own key. .env is gitignored and never committed.
# Used only by the serverless function that proxies the Anthropic API, so the
# key stays out of the browser bundle.
ANTHROPIC_API_KEY=

# Optional. Enables the ground view preview on a position card, which fetches
# real Google Street View imagery for that spot. Without it the app works
# normally and the card explains that ground view is off.
GOOGLE_MAPS_API_KEY=
