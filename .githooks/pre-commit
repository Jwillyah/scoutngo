#!/usr/bin/env bash
#
# THE COMMIT GATE.
#
# WHY THIS EXISTS. The checks were run by hand, chained with &&, and a commit
# went out with a failing `tsc -b` because the chain stopped at tsc while the
# `git commit` on the following line ran anyway. The answer to that is not more
# care. A gate that depends on remembering is not a gate.
#
# Everything that can fail a commit runs here, in cheapest-first order so a
# typo fails in two seconds rather than ninety.
#
# The browser audits need the app and a headless Chrome. The hook starts them
# itself if they are not already up, because a gate you have to prepare for is
# one you will eventually bypass.
#
# Nothing in it reaches a live host: the browser audits run against the built
# app and a fixture proxy (scripts/gate/), side by side, in under ten minutes.
#
# Emergency switch only, and it says so loudly (docs/gate.md). No audit needs
# it any more: the 3D audit that used to wait on live imagery uses fixtures.
#   SCOUTNGO_SKIP_AUDITS=1 git commit ...
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
fail() { echo "${RED}✗ $1${OFF}"; echo "${DIM}  commit refused${OFF}"; exit 1; }
ok()   { echo "${GREEN}✓ $1${OFF}"; }
step() { echo "${DIM}· $1${OFF}"; }

SCRATCH="$(mktemp -d)"
trap 'rm -rf "$SCRATCH"' EXIT
GATE_BEGAN=$(date +%s)
took() { local s=$(( $(date +%s) - GATE_BEGAN )); printf '%dm%02ds' $((s / 60)) $((s % 60)); }

# ---------------------------------------------------------------- fast gate
step "typecheck"
npx tsc -b > "$SCRATCH/tsc.log" 2>&1 || { cat "$SCRATCH/tsc.log"; fail "tsc -b"; }
ok "tsc -b"

step "lint"
npx oxlint --deny-warnings > "$SCRATCH/lint.log" 2>&1 || { cat "$SCRATCH/lint.log"; fail "oxlint --deny-warnings"; }
ok "oxlint --deny-warnings"

step "viewport units"
node scripts/audit-units.mjs > "$SCRATCH/units.log" 2>&1 || { cat "$SCRATCH/units.log"; fail "unit audit"; }
ok "$(tail -1 "$SCRATCH/units.log" | sed 's/=== //;s/ ===//')"

step "colour roles"
node scripts/audit-colors.mjs > "$SCRATCH/colors.log" 2>&1 || { cat "$SCRATCH/colors.log"; fail "colour audit"; }
ok "$(tail -1 "$SCRATCH/colors.log" | sed 's/=== //;s/ ===//')"

# Every time goes through formatClock (src/core/timezone.ts); see the script.
step "clock"
node scripts/audit-clock.mjs > "$SCRATCH/clock.log" 2>&1 || { cat "$SCRATCH/clock.log"; fail "clock audit"; }
ok "$(tail -1 "$SCRATCH/clock.log" | sed 's/=== //;s/ ===//')"

step "measured claims"
node scripts/audit-measurements.mjs > "$SCRATCH/measured.log" 2>&1 || { tail -40 "$SCRATCH/measured.log"; fail "measurement audit"; }
ok "$(tail -1 "$SCRATCH/measured.log" | sed 's/=== //;s/ ===//')"

step "tests"
npm test > "$SCRATCH/test.log" 2>&1 || { tail -40 "$SCRATCH/test.log"; fail "npm test"; }
ok "$(grep -E '^ *Tests ' "$SCRATCH/test.log" | tail -1 | tr -s ' ' | sed 's/^ //')"

step "build"
npm run build > "$SCRATCH/build.log" 2>&1 || { tail -20 "$SCRATCH/build.log"; fail "npm run build"; }
ok "build"

# The document and the bundle must agree about which commit built them. The
# whole stale-build mechanism is that comparison; see docs/deploys.md.
step "build stamp"
node scripts/audit-build-stamp.mjs > "$SCRATCH/stamp.log" 2>&1 || { cat "$SCRATCH/stamp.log"; fail "build stamp audit"; }
ok "$(tail -1 "$SCRATCH/stamp.log" | sed 's/=== //;s/ ===//')"

# ------------------------------------------------------------ browser gate
if [ "${SCOUTNGO_SKIP_AUDITS:-0}" = "1" ]; then
  echo "${YELLOW}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${OFF}"
  echo "${YELLOW}!  EMERGENCY SWITCH: BROWSER AUDITS SKIPPED by SCOUTNGO_SKIP_AUDITS=1.${OFF}"
  echo "${YELLOW}!  Nothing on screen was checked for this commit, and the network guard${OFF}"
  echo "${YELLOW}!  did not run. Say so in the report (CLAUDE.md, docs/gate.md).${OFF}"
  echo "${YELLOW}!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!${OFF}"
  exit 0
fi

# One built server (dist/, just built above), one Chrome and every WebKit
# behind the fixture proxy, the audits side by side, the network guard last.
# See scripts/gate/browser-gate.sh and docs/gate.md.
SCOUTNGO_OUT="$SCRATCH" bash scripts/gate/browser-gate.sh || fail "browser audits ($(took))"

echo "${GREEN}all gates passed in $(took)${OFF}"
