@@ -0,0 +1,108 @@
+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+import { metarTime, parseMetarSky } from '../src/core/metar.ts'
+import { skyConsensus, skyStations } from '../src/core/skyConsensus.ts'
+import { skyCondition, metarVisMiles } from '../src/core/skyWord.ts'
+import { stationSky } from '../src/lib/skyFireData.ts'
+import { consensusOf, skyReadings } from '../src/lib/useStationObs.ts'
+import { ASOS_STATIONS } from '../src/data/asosStations.ts'
+import { COOPS_MET } from '../src/data/coopsMet.ts'
+
+/*
+ * THE STATION PATH AGAINST RECORDED LIVE ANSWERS (Batch LIVE, Section 0.1).
+ * 14 Nov 12:21 PM the Sky page said "no station report in the last 75
+ * minutes" at noon. tests/data/stations-2026-11-14/ holds what weather.gov
+ * and aviationweather.gov answered at 18:04Z that day, real timestamps and
+ * all: weather.gov's KNTU latest was the 16:56Z report (an hour behind the
+ * 17:56Z METAR), its KORF and KNFE latest carried no METAR text. The phone's
+ * own path (stationSky, nearWind's airport, the consensus) is run against
+ * them at the minute they were recorded.
+ */
+const DIR = 'tests/data/stations-2026-11-14'
+const NOW = new Date(readFileSync(`${DIR}/recorded-at.txt`, 'utf8').trim())
+const AVWX = readFileSync(`${DIR}/avwx-raw.txt`, 'utf8').split('\n').map((l) => l.trim()).filter((l) => l !== '')
+const VB = { lat: 36.8435575, lon: -75.9713104 }
+
+/** weather.gov's recorded latest, and /api/metar as it answers (aviationweather.gov's newest line for the id). */
+const recorded: typeof fetch = async (input, init) => {
+  const url = String(input)
+  const nws = /api\.weather\.gov\/stations\/([A-Z0-9]{4})\/observations\/latest/.exec(url)
+  if (nws !== null) {
+    try {
+      return new Response(readFileSync(`${DIR}/nws-${nws[1]}-latest.json`, 'utf8'), { status: 200 })
+    } catch {
+      return new Response('{}', { status: 404 })
+    }
+  }
+  if (url === '/api/metar') {
+    const id = (JSON.parse(String(init?.body)) as { station: string }).station
+    const line = AVWX.find((l) => l.startsWith(`METAR ${id} `) || l.startsWith(`${id} `))
+    return line === undefined ? new Response('{}', { status: 404 }) : Response.json({ status: 'ok', metar: line })
+  }
+  throw new Error(`not recorded: ${url}`)
+}
+
+describe('a station report is timed by the report itself', () => {
+  it('metarTime reads the day-hour-minute group', () => {
+    expect(metarTime('METAR KNTU 141756Z 32012KT', NOW)?.toISOString()).toBe('2026-11-14T17:56:00.000Z')
+    expect(metarTime('no time here', NOW)).toBeNull()
+  })
+  it('stationSky takes the newer of weather.gov and aviationweather.gov: KNTU 17:56Z, not weather.gov\'s 16:56Z', async () => {
+    const s = await stationSky('KNTU', recorded, NOW)
+    expect(s?.at).toBe('2026-11-14T17:56:00.000Z')
+  })
+  it('weather.gov with no METAR text (KORF): the fallback\'s report, with its own time, never a blank time', async () => {
+    const s = await stationSky('KORF', recorded, NOW)
+    expect(s).not.toBeNull()
+    expect(s?.at).toBe('2026-11-14T17:51:00.000Z')
+  })
+  it('at the minute recorded, VB has a fresh sky report (the Sky page\'s "no station report" cannot happen with these answers)', async () => {
+    const got = consensusOf(await skyReadings(VB, [], NOW, recorded), NOW)
+    expect(got).not.toBeNull()
+    expect(NOW.getTime() - got!.at.getTime()).toBeLessThan(15 * 60_000)
+  })
+})
+
+describe('the sky word by consensus', () => {
+  it('VB reads the nearest coastal airport (KNGU, on the water at Sewells Point) and the nearest airport (KNTU)', () => {
+    expect(skyStations(VB, ASOS_STATIONS, COOPS_MET).map((s) => `${s.id}:${s.role}`)).toEqual(['KNTU:airport', 'KNGU:coastal'])
+  })
+  /* The reports each station had out at 12:19 PM EST (17:19Z), from IEM's archive of the day. */
+  const iem = readFileSync(`${DIR}/iem-metars.csv`, 'utf8').trim().split('\n').slice(1).map((l) => {
+    const [st, valid, metar] = l.split(',')
+    return { id: `K${st}`, at: new Date(`${valid.replace(' ', 'T')}:00Z`), metar }
+  })
+  const latestAt = (id: string, t: Date) => iem.filter((r) => r.id === id && r.at <= t).sort((a, b) => b.at.getTime() - a.at.getTime())[0]
+  const report = (id: string, t: Date) => {
+    const r = latestAt(id, t)
+    return { id, sky: parseMetarSky(r.metar)!, visMi: metarVisMiles(r.metar), at: r.at }
+  }
+  it('14 Nov 12:19 PM: KNTU OVC060 and KNGU BKN060 disagree, the lesser cover: Mostly cloudy, not Overcast', () => {
+    const t = new Date('2026-11-14T17:19:00Z')
+    const c = skyConsensus([report('KNTU', t), report('KNGU', t)], t)
+    expect(c?.rule).toBe('lesser')
+    expect(c?.word).toBe('Mostly cloudy')
+    const truth = JSON.parse(readFileSync('fixtures/truth/2026-11-14-vb.json', 'utf8')) as { noon: { skyTruth: string } }
+    expect(skyCondition({ code: 3, layers: { low: 60, mid: 40, high: 0 }, day: true, station: { sky: c!.sky, visMi: c!.visMi } })?.word).toBe(truth.noon.skyTruth)
+  })
+  it('both fresh and agreeing: their word (18:04Z, KNTU OVC055 and KNGU OVC050)', async () => {
+    const c = consensusOf(await skyReadings(VB, [], NOW, recorded), NOW)
+    expect(c?.rule).toBe('agree')
+    expect(c?.word).toBe('Overcast')
+  })
+  it('a stale report is no vote: one fresh station is the word', () => {
+    const t = new Date('2026-11-14T17:19:00Z')
+    const old = { ...report('KNGU', t), at: new Date(t.getTime() - 2 * 3_600_000) }
+    expect(skyConsensus([report('KNTU', t), old], t)?.rule).toBe('one')
+    expect(skyConsensus([old], t)).toBeNull()
+  })
+  it('Wrightsville Beach: KILM alone, through the same function', () => {
+    const w = skyStations({ lat: 34.21, lon: -77.796 }, ASOS_STATIONS, COOPS_MET)
+    expect(w.map((s) => s.id)).toContain('KILM')
+    const t = new Date('2026-11-14T17:19:00Z')
+    const c = skyConsensus([report('KILM', t)], t)
+    expect(c?.word).toBe('Clear')
+    /* KILM's CLR reaches 12,000 ft: "Clear" only with the sky above empty too (src/core/skyWord.ts). */
+    expect(skyCondition({ code: 1, layers: { low: 0, mid: 0, high: 40 }, day: true, station: { sky: c!.sky, visMi: c!.visMi } })?.word).not.toBe('Clear')
+  })
+})
