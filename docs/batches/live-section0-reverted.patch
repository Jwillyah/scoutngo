+++ b/scripts/measure-surf-replay.mjs
@@ -0,0 +1,99 @@
+/*
+ * THE HOME'S SURF ON 14 NOV REPLAYED, BOTH PATHS (Batch LIVE, Section 0.3).
+ * At 5:38 AM the home card said "4–6 ft Firing" while its own chart read
+ * 1.7 ft; at 12:19 PM "0–1 ft Flat" while the now-dot read 2.3 ft.
+ *
+ * Usage:  node scripts/measure-surf-replay.mjs [fetch]
+ *         With "fetch": asks Open-Meteo (marine and wind, 14 Nov, Sandbridge
+ *         to 2 decimals) and NDBC (44099's realtime file) and keeps them in
+ *         tests/data/surf-2026-11-14/. Without it: replays the kept files.
+ * Writes: measurements/2026-11-14-surf-replay.md
+ *
+ * Open-Meteo's past hours are its best run since, not the run the phone
+ * had at 5:38; the phone's per-spot book (its correction) is not known, so
+ * both are replayed untested (no history), as a new phone reads them. The
+ * buoy reading the phone had is the latest LAG_MIN before the moment (NDBC
+ * posts a half-hour's reading about that late: this script's assumption).
+ *
+ * before  the lean as it was: the buoy's whole height at its dominant
+ *         period and mean direction, the whole miss applied
+ * after   the lean now (src/core/spotSkill.ts buoyFaceFt with the .spec
+ *         split, src/core/surfNowcast.ts surfLean bounded), the call with
+ *         the hour's wind (src/core/surf.ts windQuality); the chart is the
+ *         same series (src/lib/useSurfNow.ts hours)
+ */
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { parseHourly, MARINE_NAMES, BRIEF_WIND_NAMES, hourlyAt } from '../src/lib/tideSheetData.ts'
+import { surfAt } from '../src/lib/surfDay.ts'
+import { rangeHourAt, buoyLean } from '../src/lib/surfPageData.ts'
+import { surfCall } from '../src/core/surfCall.ts'
+import { sideWords } from '../src/core/homeDay.ts'
+import { buoyFaceFt, spotStats } from '../src/core/spotSkill.ts'
+import { surfBand } from '../src/core/surfCall.ts'
+import { surfTag } from '../src/core/surf.ts'
+import { beachFactorAt } from '../src/core/beachFactor.ts'
+
+const DIR = 'tests/data/surf-2026-11-14'
+const AT = { lat: 36.72, lon: -75.93 }
+const FACING = Number(process.argv.find((a) => a.startsWith('facing='))?.slice(7) ?? 73)
+const BUOY = '44099'
+const LAG_MIN = Number(process.argv.find((a) => a.startsWith('lag='))?.slice(4) ?? 30)
+if (process.argv.includes('fetch')) {
+  mkdirSync(DIR, { recursive: true })
+  const q = (names) => new URLSearchParams({ latitude: AT.lat.toFixed(2), longitude: AT.lon.toFixed(2), hourly: names.join(','), start_date: '2026-11-14', end_date: '2026-11-15', timezone: 'GMT' })
+  const m = await fetch(`https://marine-api.open-meteo.com/v1/marine?${q(MARINE_NAMES)}`)
+  writeFileSync(`${DIR}/marine.json`, await m.text())
+  const wq = q(BRIEF_WIND_NAMES)
+  wq.set('wind_speed_unit', 'ms')
+  const w = await fetch(`https://api.open-meteo.com/v1/forecast?${wq}`)
+  writeFileSync(`${DIR}/wind.json`, await w.text())
+  const b = await fetch(`https://www.ndbc.noaa.gov/data/realtime2/${BUOY}.txt`)
+  writeFileSync(`${DIR}/${BUOY}.txt`, (await b.text()).split('\n').filter((l) => l.startsWith('#') || / 11 14 /.test(l)).join('\n'))
+  const sp = await fetch(`https://www.ndbc.noaa.gov/data/realtime2/${BUOY}.spec`)
+  writeFileSync(`${DIR}/${BUOY}.spec`, (await sp.text()).split('\n').filter((l) => l.startsWith('#') || / 11 14 /.test(l)).join('\n'))
+}
+const marine = parseHourly(JSON.parse(readFileSync(`${DIR}/marine.json`, 'utf8')), MARINE_NAMES)
+const wind = parseHourly(JSON.parse(readFileSync(`${DIR}/wind.json`, 'utf8')), BRIEF_WIND_NAMES)
+const rows = readFileSync(`${DIR}/${BUOY}.txt`, 'utf8').split('\n').filter((l) => !l.startsWith('#') && l.trim() !== '').map((l) => l.trim().split(/\s+/))
+const spec = readFileSync(`${DIR}/${BUOY}.spec`, 'utf8').split('\n').filter((l) => !l.startsWith('#') && l.trim() !== '').map((l) => l.trim().split(/\s+/))
+const num = (x) => (x === 'MM' || x === undefined ? null : Number(x))
+const splitAt = (at) => {
+  const f = spec.find((g) => new Date(`${g[0]}-${g[1]}-${g[2]}T${g[3]}:${g[4]}:00Z`).getTime() === at.getTime())
+  return f === undefined ? null : { swellM: num(f[6]), swellS: num(f[7]), windWaveM: num(f[8]), windWaveS: num(f[9]), swellFrom: f[10] === 'MM' ? null : f[10], windWaveFrom: f[11] === 'MM' ? null : f[11] }
+}
+const buoyAt = (t0) => {
+  const t = new Date(t0.getTime() - LAG_MIN * 60_000)
+  const r = rows.map((f) => ({ at: new Date(`${f[0]}-${f[1]}-${f[2]}T${f[3]}:${f[4]}:00Z`), waveM: Number(f[8]), periodS: f[9] === 'MM' ? null : Number(f[9]), fromDeg: f[11] === 'MM' ? null : Number(f[11]) })).filter((x) => x.at.getTime() <= t.getTime() && Number.isFinite(x.waveM)).sort((a, b) => b.at - a.at)[0]
+  return r === undefined ? null : { status: 'ok', buoy: { id: BUOY, name: BUOY, at: AT, km: 0 }, at: r.at, waveM: r.waveM, periodS: r.periodS, fromDeg: r.fromDeg, split: splitAt(r.at) }
+}
+const factor = beachFactorAt(AT)
+const stats = spotStats([], 0)
+const out = [`# 14 Nov surf, both paths (Batch LIVE, Section 0.3)`, '', `Run: node scripts/measure-surf-replay.mjs, ${new Date().toISOString()}. Sandbridge ${AT.lat},${AT.lon}, facing ${FACING}°, beach factor ${factor}, buoy ${BUOY}, no per-spot history.`, '']
+for (const [label, iso] of [['5:38 AM', '2026-11-14T10:38:00Z'], ['12:19 PM', '2026-11-14T17:19:00Z']]) {
+  const now = new Date(iso)
+  const half = new Date(Math.floor(now.getTime() / 3_600_000) * 3_600_000 + 1_800_000)
+  const b = buoyAt(now)
+  const oldFt = b === null ? null : buoyFaceFt({ waveM: b.waveM, periodS: b.periodS, fromDeg: b.fromDeg }, FACING, factor)
+  const newFt = b === null ? null : buoyFaceFt(b, FACING, factor)
+  const chartWas = surfAt(marine, half, FACING, factor)
+  const plain = rangeHourAt(marine, wind, half, FACING, stats, factor, null)
+  const lean = buoyLean(marine, wind, b, FACING, stats, factor, now.getTime())
+  const head = rangeHourAt(marine, wind, half, FACING, stats, factor, lean)
+  const oldCentre = plain === null || oldFt === null ? null : Math.max(0, oldFt)
+  const oldBand = oldCentre === null ? null : surfBand(oldCentre)
+  const oldTag = oldCentre === null ? null : surfTag(oldCentre, plain.shape)
+  const call = head === null ? null : surfCall({ centerFt: head.centerFt, shape: head.shape, side: head.side === null ? null : sideWords(head.side), wind: head.wind }, 0)
+  out.push(`## ${label}`, '')
+  out.push(`- buoy ${BUOY} as the phone had it (${LAG_MIN} min late): ${b === null ? 'none' : `${b.at.toISOString().slice(11, 16)}Z ${b.waveM} m ${b.periodS} s from ${b.fromDeg}°, split ${JSON.stringify(b.split)}`}`)
+  out.push(`- before: buoy face ${oldFt === null ? 'none' : oldFt.toFixed(2)} ft, headline ${oldBand === null ? 'none' : `${oldBand[0]}–${oldBand[1]} ft ${oldTag}`} (centre ${oldCentre === null ? 'none' : oldCentre.toFixed(2)}); chart ${chartWas === null ? 'none' : chartWas.estimate.faceFt.toFixed(2)} ft (the briefing's faces, unleaned)`)
+  out.push(`- after: buoy face ${newFt === null ? 'none' : newFt.toFixed(2)} ft, lean ${lean === null ? 'none' : lean.missFt.toFixed(2)} ft, headline ${call === null ? 'none' : `${call.words} ${call.size}, ${call.wind}`} (centre ${head === null ? 'none' : head.centerFt.toFixed(2)}); chart now ${head === null ? 'none' : head.centerFt.toFixed(2)} ft (the same series)`)
+  if (label === '5:38 AM' && head !== null) {
+    /* The wind the home's Wind card said then (fixtures/truth/2026-11-14-vb.json): N 20 kt. */
+    const seen = surfCall({ centerFt: head.centerFt, shape: head.shape, side: null, wind: { mps: 20 / 1.943844, fromDeg: 0, facing: FACING } }, 0)
+    out.push(`- after, with the wind the Wind card showed (N 20 kt): ${seen.words} ${seen.size}`)
+  }
+  out.push(`- wind ${(hourlyAt(wind, 'wind_speed_10m', half) * 1.943844).toFixed(1)} kt from ${hourlyAt(wind, 'wind_direction_10m', half)}°; marine wave ${hourlyAt(marine, 'wave_height', half)} m, swell ${hourlyAt(marine, 'swell_wave_height', half)} m ${hourlyAt(marine, 'swell_wave_period', half)} s from ${hourlyAt(marine, 'swell_wave_direction', half)}°, wind wave ${hourlyAt(marine, 'wind_wave_height', half)} m ${hourlyAt(marine, 'wind_wave_period', half)} s from ${hourlyAt(marine, 'wind_wave_direction', half)}°`, '')
+}
+mkdirSync('measurements', { recursive: true })
+writeFileSync('measurements/2026-11-14-surf-replay.md', out.join('\n') + '\n')
+console.log(out.join('\n'))
