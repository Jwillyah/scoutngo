+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+import { BLOWN_KT, CHOPPY_KT, surfTag, windQuality, type SurfTag } from '../src/core/surf.ts'
+import { LEAN_MAX_FT, surfLean } from '../src/core/surfNowcast.ts'
+import { buoyFaceFt, spotStats } from '../src/core/spotSkill.ts'
+import { beachFactorAt } from '../src/core/beachFactor.ts'
+import { MARINE_NAMES, BRIEF_WIND_NAMES, parseHourly } from '../src/lib/tideSheetData.ts'
+import { surfNowFrom } from '../src/lib/useSurfNow.ts'
+import type { BuoyReading } from '../src/lib/buoy.ts'
+
+/*
+ * ONE SURF SERIES AND THE WIND'S WORD (Batch LIVE, Sections 0.3 and 0.4;
+ * fixtures/truth/2026-11-14-vb.json). 14 Nov 5:38 AM at Sandbridge the home
+ * said "4-6 ft Firing" over its own chart at 1.7 ft, in N 20 kt
+ * cross-onshore: small and messy. At 12:19 PM "0-1 ft Flat" over a dot at
+ * 2.3. Both headlines were the buoy's lean (44099's wind sea read as surf,
+ * its direction swinging NE to NW); the chart was the briefing's unleaned
+ * faces (measurements/2026-11-14-surf-replay.md). The recorded inputs:
+ * tests/data/surf-2026-11-14/.
+ */
+const KT = 1.943844
+const FACING = 73
+const wind = (kt: number, fromDeg: number) => ({ mps: kt / KT, fromDeg, facing: FACING })
+
+describe('the wind word over the size, one test per band', () => {
+  /* At a beach facing 73°: from 73° onshore, from 10° cross-onshore (63° apart), from 160° cross-shore, from 200° cross-offshore, from 253° offshore. */
+  const cases: [string, number, number, SurfTag][] = [
+    ['onshore 10 kt: the size stands', 10, 73, 'Firing'],
+    [`onshore at ${CHOPPY_KT} kt exactly: the size stands`, CHOPPY_KT, 73, 'Firing'],
+    ['onshore 15 kt: Choppy', 15, 73, 'Choppy'],
+    [`onshore ${BLOWN_KT} kt: Choppy`, BLOWN_KT, 73, 'Choppy'],
+    ['onshore 22 kt: Blown out', 22, 73, 'Blown out'],
+    ['cross-onshore 14 kt: Choppy', 14, 10, 'Choppy'],
+    ['cross-onshore 20 kt (14 Nov 5:38, N 20): Blown out', 20, 0, 'Blown out'],
+    ['cross-shore 20 kt: the size stands', 20, 163, 'Firing'],
+    ['cross-offshore 20 kt: the size stands', 20, 200, 'Firing'],
+    ['offshore 25 kt: the size stands', 25, 253, 'Firing'],
+  ]
+  for (const [name, kt, from, want] of cases) it(name, () => expect(windQuality('Firing', wind(kt, from))).toBe(want))
+  it('Fun and Rideable the same; Small and Flat are never relabelled', () => {
+    expect(windQuality('Fun', wind(15, 73))).toBe('Choppy')
+    expect(windQuality('Rideable', wind(20, 73))).toBe('Blown out')
+    expect(windQuality('Small', wind(25, 73))).toBe('Small')
+    expect(windQuality('Flat', wind(25, 73))).toBe('Flat')
+  })
+  it('no wind known: the size stands', () => {
+    expect(windQuality('Firing', null)).toBe('Firing')
+    expect(windQuality('Firing', { mps: null, fromDeg: 0, facing: FACING })).toBe('Firing')
+  })
+  it('surfTag never says Fun or Firing in onshore wind over 12 kt, at any size', () => {
+    for (let ft = 0; ft <= 10; ft += 0.5) for (const kt of [12.5, 15, 18, 19, 30]) for (const from of [73, 10, 130]) expect(['Fun', 'Firing']).not.toContain(surfTag(ft, 'Clean', wind(kt, from)))
+  })
+})
+
+describe('the buoy lean, bounded and read by its split', () => {
+  it('one reading moves the centre by at most 1 ft or half of it', () => {
+    expect(surfLean(4.65, 1.78, 0)?.missFt).toBe(LEAN_MAX_FT)
+    expect(surfLean(0, 1.55, 0)?.missFt).toBe(-LEAN_MAX_FT)
+    expect(surfLean(9, 4, 0)?.missFt).toBe(2)
+    expect(surfLean(2.3, 2, 0)?.missFt).toBeCloseTo(0.3, 6)
+  })
+  it('a wind sea blowing off the beach carries nothing to it (16:26Z, WWH 1.8 m from NW)', () => {
+    const split = { swellM: 0.1, swellS: 10.5, swellFrom: 'E', windWaveM: 1.8, windWaveS: 5, windWaveFrom: 'NW' }
+    expect(buoyFaceFt({ waveM: 1.8, periodS: 5, fromDeg: 314, split }, FACING)).toBeLessThan(1)
+  })
+})
+
+describe('14 Nov replayed: one series, never 4-6 over a chart at 1.7', () => {
+  const DIR = 'tests/data/surf-2026-11-14'
+  const marine = parseHourly(JSON.parse(readFileSync(`${DIR}/marine.json`, 'utf8')), MARINE_NAMES)!
+  const windH = parseHourly(JSON.parse(readFileSync(`${DIR}/wind.json`, 'utf8')), BRIEF_WIND_NAMES)!
+  const num = (x: string | undefined) => (x === undefined || x === 'MM' ? null : Number(x))
+  const spec = readFileSync(`${DIR}/44099.spec`, 'utf8').split('\n').filter((l) => !l.startsWith('#') && l.trim() !== '').map((l) => l.trim().split(/\s+/))
+  const rows = readFileSync(`${DIR}/44099.txt`, 'utf8').split('\n').filter((l) => !l.startsWith('#') && l.trim() !== '').map((l) => l.trim().split(/\s+/))
+  const stamp = (f: string[]) => new Date(`${f[0]}-${f[1]}-${f[2]}T${f[3]}:${f[4]}:00Z`)
+  /* The reading the phone had: the latest 30 minutes before (NDBC posts that late). */
+  const buoyAt = (t: Date): BuoyReading => {
+    const f = rows.filter((r) => stamp(r).getTime() <= t.getTime() - 30 * 60_000 && r[8] !== 'MM').sort((a, b) => stamp(b).getTime() - stamp(a).getTime())[0]
+    const s = spec.find((g) => stamp(g).getTime() === stamp(f).getTime())!
+    return { status: 'ok', buoy: { id: '44099', name: 'Cape Henry', at: { lat: 36.915, lon: -75.72 }, km: 29 }, at: stamp(f), waveM: Number(f[8]), periodS: num(f[9]), fromDeg: num(f[11]), split: { swellM: num(s[6]), swellS: num(s[7]), windWaveM: num(s[8]), windWaveS: num(s[9]), swellFrom: s[10], windWaveFrom: s[11] } }
+  }
+  const read = (iso: string, windNow: { mps: number; fromDeg: number } | null) => {
+    const now = new Date(iso)
+    const sea = { status: 'ready' as const, marine, wind: windH, facing: FACING, facingState: 'ok' as const, buoy: buoyAt(now), factor: beachFactorAt({ lat: 36.72, lon: -75.93 }) }
+    return surfNowFrom(sea, spotStats([], 0), now, 'America/New_York', windNow === null ? null : { ...windNow, facing: FACING })
+  }
+  it('5:38 AM: not 4-6, not Firing; with the Wind card\'s N 20 kt, Blown out', () => {
+    const r = read('2026-11-14T10:38:00Z', { mps: 20 / KT, fromDeg: 0 })
+    const call = r.week[0].call!
+    expect(call.words).not.toBe('4–6 ft')
+    expect(call.highFt).toBeLessThanOrEqual(3)
+    expect(call.size).toBe('Blown out')
+  })
+  it('the chart\'s now is the headline\'s hour: the same centre, both moments', () => {
+    for (const iso of ['2026-11-14T10:38:00Z', '2026-11-14T17:19:00Z']) {
+      const r = read(iso, null)
+      expect(r.hours[0].centerFt).toBeCloseTo(r.week[0].hour!.centerFt, 9)
+      expect(r.hours[0].at.getTime()).toBe(r.week[0].hour!.at.getTime())
+    }
+  })
+  it('12:19 PM: the lean no longer takes the forecast to nothing (centre kept within 1 ft of it)', () => {
+    const r = read('2026-11-14T17:19:00Z', null)
+    expect(r.week[0].hour!.centerFt).toBeGreaterThan(0.5)
+    expect(Math.abs(r.week[0].hour!.leanFt)).toBeLessThanOrEqual(1 + 1e-9)
+  })
+})
