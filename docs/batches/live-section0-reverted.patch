@@ -0,0 +1,102 @@
+/*
+ * THE SKY WORD BY CONSENSUS (Batch LIVE, Section 0.2). 14 Nov 12:19 PM at
+ * Virginia Beach the home said "Overcast": KNTU's ceilometer read OVC060
+ * while the sky over the beach was broken cumulus with the sun through and
+ * blue gaps, and KNGU, on the water at Sewells Point, read SCT045 BKN060
+ * (tests/data/stations-2026-11-14/iem-metars.csv). One overcast report
+ * outvoted the rest.
+ *
+ * Now two stations are read:
+ *
+ *   coastal   the nearest airport within COAST_KM of the spot that sits on
+ *             the water: within WATER_KM of a NOAA water station (CO-OPS)
+ *   airport   the nearest airport within AIRPORT_KM, other than that one
+ *
+ * Each counts only when fresh (SKY_MAX_AGE_MS, src/core/skyWord.ts). When
+ * both are fresh and say the same word, that word. When they disagree, the
+ * one with less cover: a ceilometer looks straight up through a 30-minute
+ * window and calls a dense broken deck overcast; the station that saw gaps
+ * saw them. With one fresh, that one. Every surface takes the report this
+ * returns (src/lib/useStationObs.ts): home, menu, map strip, week, Weather,
+ * the Sky page.
+ */
+import { distanceMeters, type LatLon } from './geo.ts'
+import type { MetarSky } from './metar.ts'
+import { SKY_MAX_AGE_MS, stationWord } from './skyWord.ts'
+import type { SkyWord } from './statStrip.ts'
+
+export const COAST_KM = 40
+export const WATER_KM = 5
+export const AIRPORT_KM = 30
+
+type Asos = readonly [string, string, number, number]
+type Coops = readonly [string, string | null, string, number, number]
+
+export interface SkyStation {
+  id: string
+  km: number
+  role: 'coastal' | 'airport'
+}
+
+/** The two stations the sky word is read from, nearest first; one or none where there are fewer. */
+export function skyStations(at: LatLon, asos: readonly Asos[], coops: readonly Coops[]): SkyStation[] {
+  const box = (lat: number, lon: number, km: number) => Math.abs(lat - at.lat) <= km / 100 && Math.abs(lon - at.lon) <= km / 70
+  const near = asos
+    .filter(([, , lat, lon]) => box(lat, lon, COAST_KM + 5))
+    .map(([id, , lat, lon]) => ({ id, lat, lon, km: distanceMeters(at, { lat, lon }) / 1000 }))
+    .filter((s) => s.km <= COAST_KM)
+    .sort((a, b) => a.km - b.km)
+  const onWater = (s: { lat: number; lon: number }) => coops.some(([, , , lat, lon]) => Math.abs(lat - s.lat) < 0.1 && Math.abs(lon - s.lon) < 0.12 && distanceMeters(s, { lat, lon }) / 1000 <= WATER_KM)
+  const coast = near.find(onWater) ?? null
+  const air = near.find((s) => s.km <= AIRPORT_KM && s.id !== coast?.id) ?? null
+  const out: SkyStation[] = []
+  if (coast !== null) out.push({ id: coast.id, km: coast.km, role: 'coastal' })
+  if (air !== null) out.push({ id: air.id, km: air.km, role: 'airport' })
+  return out.sort((a, b) => a.km - b.km)
+}
+
+export interface SkyReport {
+  id: string
+  sky: MetarSky
+  visMi: number | null
+  at: Date
+}
+
+export interface SkyConsensus {
+  /** The report the word is read from. */
+  sky: MetarSky
+  visMi: number | null
+  at: Date
+  id: string
+  /** Its word (src/core/skyWord.ts stationWord). */
+  word: SkyWord | null
+  /** How it was chosen. */
+  rule: 'agree' | 'lesser' | 'one'
+  /** The other station's id and word when two were read. */
+  other: { id: string; word: SkyWord | null; at: Date } | null
+}
+
+const RANK: readonly (SkyWord | null)[] = [null, 'Clear', 'Few clouds', 'High cloud', 'Partly cloudy', 'Mostly cloudy', 'Overcast']
+
+export const isFresh = (at: Date, now: Date): boolean => {
+  const age = now.getTime() - at.getTime()
+  return age <= SKY_MAX_AGE_MS && age >= -10 * 60_000
+}
+
+/** The sky word's report from the stations' latest, or null when none is fresh. */
+export function skyConsensus(reports: readonly (SkyReport | null)[], now: Date): SkyConsensus | null {
+  const fresh = reports.filter((r): r is SkyReport => r !== null && isFresh(r.at, now))
+  if (fresh.length === 0) return null
+  const said = fresh.map((r) => ({ r, word: stationWord(r.sky) }))
+  if (said.length === 1) return { ...pick(said[0].r), word: said[0].word, rule: 'one', other: null }
+  const [a, b] = said
+  if (a.word === b.word) return { ...pick(a.r), word: a.word, rule: 'agree', other: { id: b.r.id, word: b.word, at: b.r.at } }
+  /* A report that says nothing of the sky is not a vote for less. */
+  const ranked = [a, b].filter((x) => x.word !== null).sort((x, y) => RANK.indexOf(x.word) - RANK.indexOf(y.word))
+  const lo = ranked[0] ?? a
+  const hi = lo === a ? b : a
+  return { ...pick(lo.r), word: lo.word, rule: ranked.length === 2 ? 'lesser' : 'one', other: { id: hi.r.id, word: hi.word, at: hi.r.at } }
+}
+
+const pick = (r: SkyReport) => ({ sky: r.sky, visMi: r.visMi, at: r.at, id: r.id })
+
