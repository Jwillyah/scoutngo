+++ b/tests/windSideNext.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, it } from 'vitest'
+import { nextSideChange, sideSpanWords } from '../src/core/homeDay.ts'
+
+/*
+ * THE WIND CARD SAYS ONLY WHAT IS STILL TO COME (Batch LIVE, Section 0.5;
+ * fixtures/truth/2026-11-14-vb.json: at 5:38 AM it said "→ cross-off 5a").
+ * The forecast's hours sit at half past; the 5 AM hour starts at 5:00.
+ */
+const at = (h: number, m = 30) => new Date(Date.UTC(2026, 10, 14, h + 5, m))
+const hours = [
+  { at: at(5), side: 'Cross-offshore' as const },
+  { at: at(6), side: 'Cross-offshore' as const },
+  { at: at(9), side: 'Offshore' as const },
+]
+
+describe('the next side change', () => {
+  it('at 5:38 the 5 AM hour has begun: its change is not said; the next one is', () => {
+    const c = nextSideChange(hours, 'Cross-onshore', at(5, 38))
+    expect(c?.at.getTime()).toBe(at(6, 0).getTime())
+    expect(sideSpanWords('Cross-onshore', c, 'America/New_York')).toMatch(/6a$/)
+  })
+  it('a change that has passed is never the line', () => {
+    expect(nextSideChange(hours, 'Cross-offshore', at(9, 10))).toBeNull()
+    expect(sideSpanWords('Cross-offshore', null, 'America/New_York')).toMatch(/all day$/)
+  })
+})
