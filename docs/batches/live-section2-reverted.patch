+ * page's own (ui-seg): the sun's arc over the horizon with now on it and the
+ * golden and blue hours where the arc crosses them; the moon's real phase
+ * drawn large, its rise and set, 14 days of phases and the next big
+ * moonrise; the night's Milky Way, darkest window, North Star and next
+ * meteor shower. The links that were one line ("Line it up, the light, the
+ * sun's day, a moonrise, cams") are rows. Arithmetic: src/core/sunMoonNight.ts.
+ */
+type Tab = 'sun' | 'moon' | 'night'
+
+export interface SmnLink {
+  label: string
+  onOpen: () => void
+}
+
+const W = 320
+const H = 196
+const HORIZON = 120
+
+export function SunMoonNight({ venue, now, timeZone, links, onTab }: { venue: LatLon; now: Date; timeZone: string; links: SmnLink[]; onTab?: (t: Tab) => void }) {
+  const [tab, setTabState] = useState<Tab>('sun')
+  const setTab = (t: Tab) => {
+    setTabState(t)
+    onTab?.(t)
+  }
+  const clock = (d: Date) => formatClock(d, timeZone)
+  const minute = Math.floor(now.getTime() / 60_000)
+  const sun = useMemo(() => sunDay(new Date(minute * 60_000), venue.lat, venue.lon, timeZone), [minute, venue.lat, venue.lon, timeZone])
+  const moon = useMemo(() => moonView(new Date(minute * 60_000), venue.lat, venue.lon, timeZone), [minute, venue.lat, venue.lon, timeZone])
+  const night = useMemo(() => nightView(venue.lat, venue.lon, timeZone, localDate(new Date(minute * 60_000), timeZone)), [minute, venue.lat, venue.lon, timeZone])
+  const day = (d: Date) => new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone }).format(d)
+
+  /* The arc: x across, the altitude up from the horizon line, scaled to the day's highest sun. */
+  const top = Math.max(20, sun.noonAlt + 6)
+  const px = (x: number) => 10 + x * (W - 20)
+  const py = (alt: number) => HORIZON - (alt / top) * (HORIZON - 12)
+  const line = (pts: { x: number; alt: number }[]) => pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${px(p.x).toFixed(1)} ${py(p.alt).toFixed(1)}`).join(' ')
+  const within = ([a, b]: [number, number]) => sun.arc.filter((p) => p.x >= a && p.x <= b)
+
+  return (
+    <div className="smn" data-smn>
+      <div className="ui-seg spage__seg" role="tablist" aria-label="Sun, moon or night">
+        {(['sun', 'moon', 'night'] as const).map((k) => (
+          <button key={k} type="button" role="tab" aria-selected={tab === k} className={`ui-seg__opt${tab === k ? ' ui-seg__opt--on' : ''}`} onClick={() => setTab(k)}>
+            {k === 'sun' ? 'Sun' : k === 'moon' ? 'Moon' : 'Night'}
+          </button>
+        ))}
+      </div>
+
+      {tab === 'sun' ? (
+        <section className="dcard smn__card" aria-label="The sun today">
+          <p className="smn__now" data-sun-now>
+            {sun.nowLine}
+          </p>
+          <svg className="smn__arc" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`The sun's path today. ${sun.nowLine}`}>
+            {sun.golden.map((s) => (
+              <path key={`g${s[0]}`} d={line(within(s))} className="smn__band smn__band--golden" />
+            ))}
+            {sun.blue.map((s) => (
+              <path key={`b${s[0]}`} d={line(within(s))} className="smn__band smn__band--blue" />
+            ))}
+            <path d={line(sun.arc)} className="smn__path" />
+            <line x1="0" x2={W} y1={HORIZON} y2={HORIZON} className="smn__horizon" />
+            {sun.now === null ? null : <circle cx={px(sun.now.x)} cy={py(sun.now.alt)} r="9" className={sun.now.alt > 0 ? 'smn__sun' : 'smn__sun smn__sun--down'} data-sun-dot />}
+            <text x="10" y={HORIZON + 44} className="smn__k">
+              {sun.rise === null ? '' : `rise ${clock(sun.rise.at)}`}
+            </text>
+            <text x={W - 10} y={HORIZON + 44} className="smn__k" textAnchor="end">
+              {sun.set === null ? '' : `set ${clock(sun.set.at)}`}
+            </text>
+            <text x="10" y={HORIZON + 62} className="smn__k smn__k--dim">
+              {sun.rise?.point ?? ''}
+            </text>
+            <text x={W - 10} y={HORIZON + 62} className="smn__k smn__k--dim" textAnchor="end">
+              {sun.set?.point ?? ''}
+            </text>
+          </svg>
+          <p className="smn__legend">
+            <i className="smn__sw smn__sw--golden" /> golden hour <i className="smn__sw smn__sw--blue" /> blue hour
+          </p>
+        </section>
+      ) : null}
+
+      {tab === 'moon' ? (
+        <section className="dcard smn__card" aria-label="The moon">
+          <div className="smn__moonrow">
+            <svg className="smn__moon" viewBox="0 0 120 120" role="img" aria-label={`${moon.name}, ${Math.round(moon.fraction * 100)}% lit`} data-moon-lit={Math.round(moon.fraction * 100)}>
+              <circle cx="60" cy="60" r="50" className="smn__moondark" />
+              <path d={moonPath(60, 60, 50, moon.fraction, moon.waxing)} className="smn__moonlit" />
+            </svg>
+            <div className="smn__moonfacts">
+              <p className="smn__big">{moon.name}</p>
+              <p className="smn__line num">{Math.round(moon.fraction * 100)}% lit</p>
+              <p className="smn__line num">{moon.rise === null ? 'No rise today' : `Rises ${clock(moon.rise.at)} · ${moon.rise.point}`}</p>
+              <p className="smn__line num">{moon.set === null ? 'No set today' : `Sets ${clock(moon.set.at)} · ${moon.set.point}`}</p>
+            </div>
+          </div>
+          <ol className="smn__strip" aria-label="The next 14 days">
+            {moon.strip.map((d, i) => (
+              <li key={i}>
+                <svg viewBox="0 0 24 24" aria-hidden="true">
+                  <circle cx="12" cy="12" r="10" className="smn__moondark" />
+                  <path d={moonPath(12, 12, 10, d.fraction, d.phase < 0.5)} className="smn__moonlit" />
+                </svg>
+                <span>{new Intl.DateTimeFormat('en-US', { weekday: 'narrow', timeZone }).format(d.at)}</span>
+              </li>
+            ))}
+          </ol>
+          <p className="smn__line" data-big-rise>
+            {moon.bigRise === null ? 'No big moonrise (95% lit, rising within an hour of sunset) in the next 45 days.' : `Next big moonrise: ${day(moon.bigRise.at)} ${clock(moon.bigRise.at)}, ${moon.bigRise.point}, ${Math.round(moon.bigRise.fraction * 100)}% lit`}
+          </p>
+        </section>
+      ) : null}
+
+      {tab === 'night' ? (
+        <section className="dcard smn__card" aria-label="The night">
+          <ul className="smn__rows">
+            <li>
+              <b>Milky Way</b>
+              <span data-milky>{night.milky.yes && night.milky.window !== null ? `Yes · ${clock(night.milky.window.from)}–${clock(night.milky.window.to)}` : `No · ${night.milky.reason}`}</span>
+            </li>
+            <li>
+              <b>Darkest</b>
+              <span>{night.darkest === null ? 'No full dark with the moon down tonight' : `${clock(night.darkest.from)}–${clock(night.darkest.to)}, moon down`}</span>
+            </li>
+            <li>
+              <b>North Star</b>
+              <span>{venue.lat >= 0 ? `${night.northStar.point}, ${Math.round(night.northStar.altitude)}° up` : night.northStar.point}</span>
+            </li>
+            <li>
+              <b>Meteors</b>
+              <span>{night.shower === null ? 'none listed' : `${night.shower.name}, peak ${day(night.shower.peak)}${night.shower.days <= 0 ? ' (tonight)' : ` · in ${night.shower.days} days`}`}</span>
+            </li>
+          </ul>
+        </section>
+      ) : null}
+
+      {links.length === 0 ? null : (
+        <ul className="dcard smn__links" aria-label="More">
+          {links.map((l) => (
+            <li key={l.label}>
+              <button type="button" className="smn__link" onClick={l.onOpen}>
+                {l.label} <span aria-hidden="true">›</span>
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  )
+}
