+const LEAD: readonly SkyNowRead['worth'][number]['kind'][] = ['rays', 'halo', 'iridescence', 'texture']
+
+export function nowHeadline(read: SkyNowRead, sunDeg: number, sunPoint: string): { head: string; line: string } {
+  const kinds = read.worth.map((w) => w.kind)
+  const lead = LEAD.find((k) => kinds.includes(k)) ?? null
+  const up = sunDeg > 0
+  const also = (k: string) => (kinds.length > 1 ? ` · also ${kinds.filter((x) => x !== k).join(', ')}` : '')
+  if (lead === 'rays') return { head: 'Look for light rays', line: `sun ${Math.round(sunDeg)}° up in the ${sunPoint}, behind broken cloud${also('rays')}` }
+  if (lead === 'halo') return { head: 'Look for a halo', line: `22° out from the sun, ${sunPoint}${also('halo')}` }
+  if (lead === 'iridescence') return { head: 'Look for iridescence', line: `thin cloud near the sun, ${sunPoint}; shade the sun with your hand${also('iridescence')}` }
+  if (lead === 'texture') return { head: 'Textured clouds now', line: `${up ? `sun through gaps, look ${sunPoint}` : 'look up'}${also('texture')}` }
+  return { head: 'Nothing special now', line: `${(read.nothing ?? 'nothing found').replace(/^./, (c) => c.toUpperCase())}.` }
+}
+
+/*
+ * THE SKY NOW, DRAWN FROM THE SIDE (Batch LIVE, Section 2.2; the style of
+ * the Sky page's view toward the sun, src/core/skyPage.ts sideView). Each
+ * deck the station reports at its base (a square root of the height, so a
+ * low deck is not squashed onto the horizon), the forecast's high layer
+ * above the ceilometer's reach when the station reports none there; each
+ * drawn as NOW_CELLS cells across, as many filled as its cover says, spread
+ * evenly so the gaps show where they are; the sun at its real height, on the
+ * side of its compass point (east left, west right, as you face south).
+ */
+export const NOW_CELLS = 12
+const TOP_FT = 40_000
+const COVER_PCT: Record<CloudGroup['amount'], number> = { FEW: 20, SCT: 45, BKN: 75, OVC: 100, VV: 100 }
+
+export interface NowDeck {
+  y: number
+  label: string
+  cover: number
+  /** Filled cells, each [from, to] across 0-1. */
+  cells: [number, number][]
+  forecast: boolean
+}
+
+export function nowPicture(station: MetarSky | null, model: { high: number | null } | null, sunDeg: number, sunAzDeg: number): { decks: NowDeck[]; sun: { x: number; y: number } | null } {
+  const y = (ft: number) => 0.9 - 0.8 * Math.sqrt(Math.max(0, Math.min(TOP_FT, ft)) / TOP_FT)
+  const cellsOf = (cover: number): [number, number][] => {
+    const n = Math.max(0, Math.min(NOW_CELLS, Math.round((cover / 100) * NOW_CELLS)))
+    const out: [number, number][] = []
+    /* Evenly spread: cell i is filled when the running share crosses a whole cell. */
+    for (let i = 0; i < NOW_CELLS; i += 1) if (Math.floor(((i + 1) * n) / NOW_CELLS) > Math.floor((i * n) / NOW_CELLS)) out.push([0.04 + (0.92 * i) / NOW_CELLS, 0.04 + (0.92 * (i + 0.86)) / NOW_CELLS])
+    return out
+  }
+  const decks: NowDeck[] = (station?.groups ?? [])
+    .filter((g) => g.amount !== 'VV')
+    .map((g) => ({ y: y(g.baseFt), label: `${g.amount} ${k(g.baseFt)}`, cover: COVER_PCT[g.amount], cells: cellsOf(COVER_PCT[g.amount]), forecast: false }))
+  const reportedHigh = (station?.groups ?? []).some((g) => layerOf(g.baseFt) === 'high')
+  const high = model?.high ?? null
+  if (!reportedHigh && high !== null && high >= 10) decks.push({ y: y(30_000), label: `high ${Math.round(high)}% (forecast)`, cover: high, cells: cellsOf(high), forecast: true })
+  /* The sun: up only; its height on the same scale as the view's angle (0° the horizon, 90° the top). */
+  const east = ((sunAzDeg % 360) + 360) % 360 < 180
+  const sun = sunDeg <= 0 ? null : { x: east ? 0.14 : 0.86, y: 0.9 - 0.8 * Math.min(1, sunDeg / 90) }
+  return { decks, sun }
+}
