+/*
+ * SUN · MOON · NIGHT, THE ARITHMETIC (Batch LIVE, Section 2.5). The page
+ * (src/components/SunMoonNight.tsx) only draws what this returns.
+ *
+ *   sun    the day's arc over the horizon, sampled every SAMPLE_MIN from an
+ *          hour before sunrise to an hour after sunset; the golden (sun +6°
+ *          to -4°) and blue (-4° to -6°) bands where the arc crosses them;
+ *          sunrise and sunset with their compass points; the sun now
+ *          ("Sun now · south, 34° up")
+ *   moon   the phase (lit fraction and whether waxing), rise and set with
+ *          their points, a 14-day strip of phases, and the next big
+ *          moonrise: a moon 95% lit or more rising within BIG_RISE_MIN of
+ *          sunset, in the next 45 days
+ *   night  the Milky Way's core tonight (src/core/milkyWay.ts), the darkest
+ *          window (astronomical dark with the moon down), the North Star
+ *          (due north, as high as the latitude), and the next meteor shower
+ *          peak (src/core/celestial.ts SHOWERS)
+ */
+import { getMoonIllumination, getMoonPosition, getPosition, getTimes } from 'suncalc'
+import { compassPoint } from './field.ts'
+import { moonTimesOnLocalDay } from './moonTimes.ts'
+import { milkyWayNight } from './milkyWay.ts'
+import { SHOWERS } from './celestial.ts'
+import { formatClock } from './timezone.ts'
+
+export const SAMPLE_MIN = 10
+export const BIG_RISE_MIN = 60
+export const GOLDEN_TOP = 6
+export const BLUE_TOP = -4
+export const BLUE_BOTTOM = -6
+
+const DIR: Record<string, string> = { N: 'north', NNE: 'north-northeast', NE: 'northeast', ENE: 'east-northeast', E: 'east', ESE: 'east-southeast', SE: 'southeast', SSE: 'south-southeast', S: 'south', SSW: 'south-southwest', SW: 'southwest', WSW: 'west-southwest', W: 'west', WNW: 'west-northwest', NW: 'northwest', NNW: 'north-northwest' }
+/** "south", "west-southwest". */
+export const directionWord = (deg: number): string => DIR[compassPoint(deg)] ?? compassPoint(deg)
+
+const ok = (d: unknown): d is Date => d instanceof Date && Number.isFinite(d.getTime())
+
+export interface SunDay {
+  rise: { at: Date; point: string } | null
+  set: { at: Date; point: string } | null
+  /** x 0-1 across the span, altitude in degrees. */
+  arc: { x: number; alt: number }[]
+  from: Date
+  to: Date
+  /** The arc's spans in each band, as x ranges. */
+  golden: [number, number][]
+  blue: [number, number][]
+  now: { x: number; alt: number; az: number } | null
+  /** "Sun now · south, 34° up"; "Sun down · rises 6:41 AM, east-southeast". */
+  nowLine: string
+  /** The highest the sun gets. */
+  noonAlt: number
+}
+
+function spans(arc: { x: number; alt: number }[], inside: (alt: number) => boolean): [number, number][] {
+  const out: [number, number][] = []
+  let start: number | null = null
+  for (const p of arc) {
+    if (inside(p.alt) && start === null) start = p.x
+    if (!inside(p.alt) && start !== null) {
+      out.push([start, p.x])
+      start = null
+    }
+  }
+  if (start !== null) out.push([start, arc[arc.length - 1].x])
+  return out
+}
+
+export function sunDay(now: Date, lat: number, lon: number, timeZone: string): SunDay {
+  const t = getTimes(now, lat, lon)
+  const rise = ok(t.sunrise) ? t.sunrise : null
+  const set = ok(t.sunset) ? t.sunset : null
+  const noon = ok(t.solarNoon) ? t.solarNoon : now
+  const from = new Date((rise ?? new Date(noon.getTime() - 6 * 3_600_000)).getTime() - 3_600_000)
+  const to = new Date((set ?? new Date(noon.getTime() + 6 * 3_600_000)).getTime() + 3_600_000)
+  const span = to.getTime() - from.getTime()
+  const arc: { x: number; alt: number }[] = []
+  for (let ms = 0; ms <= span; ms += SAMPLE_MIN * 60_000) arc.push({ x: ms / span, alt: getPosition(new Date(from.getTime() + ms), lat, lon).altitude })
+  const p = getPosition(now, lat, lon)
+  const inSpan = now.getTime() >= from.getTime() && now.getTime() <= to.getTime()
+  const clock = (d: Date) => formatClock(d, timeZone)
+  const nowLine =
+    p.altitude > 0
+      ? `Sun now · ${directionWord(p.azimuth)}, ${Math.round(p.altitude)}° up`
+      : rise !== null && now.getTime() < rise.getTime()
+        ? `Sun down · rises ${clock(rise)}, ${directionWord(getPosition(rise, lat, lon).azimuth)}`
+        : `Sun down · set ${set === null ? '—' : clock(set)}`
+  return {
+    rise: rise === null ? null : { at: rise, point: directionWord(getPosition(rise, lat, lon).azimuth) },
+    set: set === null ? null : { at: set, point: directionWord(getPosition(set, lat, lon).azimuth) },
+    arc,
+    from,
+    to,
+    golden: spans(arc, (a) => a <= GOLDEN_TOP && a > BLUE_TOP),
+    blue: spans(arc, (a) => a <= BLUE_TOP && a > BLUE_BOTTOM),
+    now: inSpan ? { x: (now.getTime() - from.getTime()) / span, alt: p.altitude, az: p.azimuth } : null,
+    nowLine,
+    noonAlt: getPosition(noon, lat, lon).altitude,
+  }
+}
+
+export interface MoonView {
+  fraction: number
+  waxing: boolean
+  /** suncalc's phase, 0 new, 0.5 full. */
+  phase: number
+  /** The bright limb's angle, degrees (suncalc), for the drawing. */
+  angle: number
+  name: string
+  rise: { at: Date; point: string } | null
+  set: { at: Date; point: string } | null
+  strip: { at: Date; phase: number; fraction: number }[]
+  bigRise: { at: Date; point: string; fraction: number } | null
+}
+
+export function phaseName(phase: number): string {
+  const p = ((phase % 1) + 1) % 1
+  if (p < 0.03 || p > 0.97) return 'New moon'
+  if (p < 0.22) return 'Waxing crescent'
+  if (p < 0.28) return 'First quarter'
+  if (p < 0.47) return 'Waxing gibbous'
+  if (p < 0.53) return 'Full moon'
+  if (p < 0.72) return 'Waning gibbous'
+  if (p < 0.78) return 'Last quarter'
+  return 'Waning crescent'
+}
+
+export function moonView(now: Date, lat: number, lon: number, timeZone: string): MoonView {
+  const ill = getMoonIllumination(now)
+  const times = moonTimesOnLocalDay(now, lat, lon, timeZone)
+  const at = (d: Date | null) => (d === null ? null : { at: d, point: directionWord(getMoonPosition(d, lat, lon).azimuth) })
+  const strip = Array.from({ length: 14 }, (_, i) => {
+    const d = new Date(now.getTime() + i * 86_400_000)
+    const m = getMoonIllumination(d)
+    return { at: d, phase: m.phase, fraction: m.fraction }
+  })
+  let bigRise: MoonView['bigRise'] = null
+  for (let i = 0; i < 45 && bigRise === null; i += 1) {
+    const day = new Date(now.getTime() + i * 86_400_000)
+    const r = moonTimesOnLocalDay(day, lat, lon, timeZone).rise
+    const s = getTimes(day, lat, lon).sunset
+    if (r === null || !ok(s) || r.getTime() < now.getTime()) continue
+    const f = getMoonIllumination(r).fraction
+    if (f >= 0.95 && Math.abs(r.getTime() - s.getTime()) <= BIG_RISE_MIN * 60_000) bigRise = { at: r, point: directionWord(getMoonPosition(r, lat, lon).azimuth), fraction: f }
+  }
+  return { fraction: ill.fraction, waxing: ill.phase < 0.5, phase: ill.phase, angle: ill.angle, name: phaseName(ill.phase), rise: at(times.rise), set: at(times.set), strip, bigRise }
+}
+
+export interface NightView {
+  milky: { yes: boolean; window: { from: Date; to: Date } | null; reason: string }
+  darkest: { from: Date; to: Date } | null
+  northStar: { point: string; altitude: number }
+  shower: { name: string; peak: Date; days: number } | null
+}
+
+export function nightView(lat: number, lon: number, timeZone: string, localDate: string): NightView {
+  const mw = milkyWayNight(localDate, lat, lon, timeZone)
+  /* The darkest window: full dark with the moon below the horizon, sampled every 10 minutes. */
+  let darkest: NightView['darkest'] = null
+  if (mw.dark !== null) {
+    let best: { from: Date; to: Date } | null = null
+    let run: Date | null = null
+    for (let ms = mw.dark.from.getTime(); ms <= mw.dark.to.getTime(); ms += SAMPLE_MIN * 60_000) {
+      const t = new Date(ms)
+      const down = getMoonPosition(t, lat, lon).altitude < 0
+      if (down && run === null) run = t
+      if ((!down || ms + SAMPLE_MIN * 60_000 > mw.dark.to.getTime()) && run !== null) {
+        const end = down ? t : new Date(ms - SAMPLE_MIN * 60_000)
+        if (best === null || end.getTime() - run.getTime() > best.to.getTime() - best.from.getTime()) best = { from: run, to: end }
+        run = null
+      }
+    }
+    darkest = best !== null && best.to.getTime() > best.from.getTime() ? best : null
+  }
+  /* The next shower peak from today (this year's or next year's date). */
+  const year = Number(localDate.slice(0, 4))
+  const today = Date.parse(`${localDate}T12:00:00Z`)
+  const peaks = SHOWERS.flatMap((s) => [year, year + 1].map((y) => ({ name: s.name, peak: new Date(Date.UTC(y, s.peakMonth - 1, s.peakDay, 12)) }))).filter((p) => p.peak.getTime() >= today - 86_400_000).sort((a, b) => a.peak.getTime() - b.peak.getTime())
+  const next = peaks[0] ?? null
+  return {
+    milky: { yes: mw.window !== null && mw.shootMinutes > 0, window: mw.window, reason: mw.reason },
+    darkest,
+    northStar: { point: lat >= 0 ? 'due north' : 'below the horizon (south of the equator)', altitude: Math.max(0, lat) },
+    shower: next === null ? null : { name: next.name, peak: next.peak, days: Math.round((next.peak.getTime() - today) / 86_400_000) },
+  }
+}
+
+/** The lit part of a moon of radius r at (cx, cy): the bright limb on the right while waxing (northern sky), the terminator an ellipse. */
+export function moonPath(cx: number, cy: number, r: number, fraction: number, waxing: boolean): string {
+  const f = Math.max(0, Math.min(1, fraction))
+  const rx = r * Math.abs(1 - 2 * f)
+  const top = `${cx} ${cy - r}`
+  const bottom = `${cx} ${cy + r}`
+  /* Outer limb: right half when waxing, left when waning. */
+  const outerSweep = waxing ? 1 : 0
+  /* Terminator back up: bulging toward the lit side past half. */
+  const innerSweep = (f > 0.5) === waxing ? 1 : 0
+  return `M ${top} A ${r} ${r} 0 0 ${outerSweep} ${bottom} A ${rx} ${r} 0 0 ${innerSweep} ${top} Z`
+}
