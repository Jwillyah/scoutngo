diff --git a/scripts/measure-rare-light.mjs b/scripts/measure-rare-light.mjs
new file mode 100644
index 0000000..caaee63
--- /dev/null
+++ b/scripts/measure-rare-light.mjs
@@ -0,0 +1,63 @@
+/*
+ * THE WEEK'S RARE LIGHT, BEFORE AND AFTER (Batch LIVE, Section 2.3). On 14
+ * Nov the Sky page listed light rays at 3 PM nearly every day, the sun
+ * 18-19° up. The rule now: the sun at most 15° up, low cloud 30-80% at the
+ * ring point toward the sun, half the models or more agreeing; at most three
+ * rows a week, ranked.
+ *
+ * Usage:  node scripts/measure-rare-light.mjs [fetch]
+ *         With "fetch": asks Open-Meteo for the week (the app's own
+ *         fetchSpecialWeek, the Virginia Beach Fishing Pier) and keeps it in
+ *         tests/data/rare-2026-11-14/week.json. Without it: replays the kept week.
+ * Writes: measurements/2026-11-14-rare-light[-<label>].md (label=before: the run on the code before the rule changed)
+ *
+ * "before" is the old rule replayed here (the sun at most 25° up, low cloud
+ * 30-80% over the spot, any one model; four rows); "after" is the app's.
+ */
+import { mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { getPosition } from 'suncalc'
+import { fetchSpecialWeek, specialsFrom } from '../src/lib/specialLightData.ts'
+import { rareRows } from '../src/core/skyPage.ts'
+
+const DIR = 'tests/data/rare-2026-11-14'
+const LABEL = process.argv.find((a) => a.startsWith('label='))?.slice(6) ?? null
+const VENUE = { lat: 36.8435575, lon: -75.9713104 }
+if (process.argv.includes('fetch')) {
+  const got = await fetchSpecialWeek(VENUE)
+  if (got === null) throw new Error('the week did not load')
+  const seaHours = got.week.hours.map((t) => got.seaCAt(t))
+  mkdirSync(DIR, { recursive: true })
+  writeFileSync(`${DIR}/week.json`, JSON.stringify({ fetchedAt: new Date().toISOString(), week: { ...got.week, hours: got.week.hours.map((t) => t.toISOString()) }, sea: seaHours }))
+}
+const kept = JSON.parse(readFileSync(`${DIR}/week.json`, 'utf8'))
+const week = { ...kept.week, hours: kept.week.hours.map((t) => new Date(t)) }
+const seaCAt = (t) => kept.sea[week.hours.findIndex((h) => h.getTime() === t.getTime())] ?? null
+const now = new Date(kept.fetchedAt)
+const local = (d) => d.toLocaleString('en-US', { timeZone: 'America/New_York', weekday: 'short', hour: 'numeric', minute: '2-digit' })
+
+/* The old rule, replayed: every hour any model has the sun 0-25° up and low cloud 30-80% over the spot. */
+const models = Object.keys(week.series)
+const oldHours = week.hours.filter((t, h) => {
+  const sun = getPosition(t, VENUE.lat, VENUE.lon).altitude
+  return sun > 0 && sun <= 25 && models.some((m) => {
+    const c = week.series[m][0].cloud_cover_low[h]
+    return c != null && c >= 30 && c <= 80
+  })
+})
+const oldDays = new Set(oldHours.map((t) => local(t).split(' ')[0]))
+const after = specialsFrom(week, VENUE, seaCAt)
+const afterRays = after.filter((s) => s.kind === 'rays')
+const rows = rareRows(after, now, VENUE)
+const out = [
+  '# Rare light, the week of 14 Nov (Batch LIVE, Section 2.3)',
+  '',
+  `Run: node scripts/measure-rare-light.mjs; the week fetched ${kept.fetchedAt}; Virginia Beach Fishing Pier ${VENUE.lat},${VENUE.lon}; ${models.length} models.`,
+  '',
+  `- the old rule replayed: rays hours ${oldHours.length}, on ${oldDays.size} days (${[...oldDays].join(', ')})`,
+  `- ${LABEL ?? 'this code'}: rays windows ${afterRays.length}${afterRays.length === 0 ? '' : ` (${afterRays.map((s) => `${local(s.from)} ${s.agree}/${s.of}, sun ${Math.round(getPosition(s.from, VENUE.lat, VENUE.lon).altitude)}°`).join('; ')})`}`,
+  `- ${LABEL ?? 'this code'}: rows on the page ${rows.length}: ${rows.length === 0 ? 'Nothing rare this week' : rows.map((r) => `${r.name} ${local(r.at)}`).join('; ')}`,
+  `- ${LABEL ?? 'this code'}: Light rays rows ${rows.filter((r) => r.kind === 'rays').length}`,
+]
+mkdirSync('measurements', { recursive: true })
+writeFileSync(`measurements/2026-11-14-rare-light${LABEL === null ? '' : `-${LABEL}`}.md`, out.join('\n') + '\n')
+console.log(out.join('\n'))
