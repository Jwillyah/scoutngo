diff --git a/tests/sunMoonNight.test.ts b/tests/sunMoonNight.test.ts
new file mode 100644
index 0000000..92f879c
--- /dev/null
+++ b/tests/sunMoonNight.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it } from 'vitest'
+import { getTimes } from 'suncalc'
+import { moonPosition2, sunPosition2 } from '../src/core/ephemeris2.ts'
+import { moonTimesOnLocalDay } from '../src/core/moonTimes.ts'
+import { directionWord, moonPath, moonView, nightView, phaseName, sunDay } from '../src/core/sunMoonNight.ts'
+
+/*
+ * SUN · MOON · NIGHT (Batch LIVE, Section 2.5). What the page says of the
+ * moon and the sun is held against a second ephemeris that shares no code
+ * with suncalc (src/core/ephemeris2.ts, Meeus): every rise and set over 30
+ * days at Virginia Beach within 5 minutes. The app draws no planets.
+ */
+const VB = { lat: 36.8435575, lon: -75.9713104 }
+const TZ = 'America/New_York'
+const START = new Date('2026-11-14T17:00:00Z')
+
+/** The minute an altitude function crosses `h0` going up (or down), scanned a minute at a time within ±3 h of a guess. */
+function crossing(alt: (t: Date) => number, guess: Date, h0: number, rising: boolean): Date | null {
+  for (let m = -180; m <= 180; m += 1) {
+    const a = alt(new Date(guess.getTime() + m * 60_000)) - h0
+    const b = alt(new Date(guess.getTime() + (m + 1) * 60_000)) - h0
+    if ((rising && a < 0 && b >= 0) || (!rising && a > 0 && b <= 0)) return new Date(guess.getTime() + (m + a / (a - b)) * 60_000)
+  }
+  return null
+}
+
+describe('against a second ephemeris, within 5 minutes', () => {
+  it('moonrise and moonset, 30 days', () => {
+    let checked = 0
+    for (let d = 0; d < 30; d += 1) {
+      const t = moonTimesOnLocalDay(new Date(START.getTime() + d * 86_400_000), VB.lat, VB.lon, TZ)
+      /* Rise and set when the moon's upper limb meets the horizon with refraction: the centre's topocentric altitude -0.83° (semidiameter 0.26°, refraction 0.57°). */
+      const alt = (x: Date) => moonPosition2(x, VB.lat, VB.lon).altitude
+      for (const [at, up] of [[t.rise, true], [t.set, false]] as const) {
+        if (at === null) continue
+        const other = crossing(alt, at, -0.83, up)
+        expect(other, `${up ? 'rise' : 'set'} ${at.toISOString()}`).not.toBeNull()
+        expect(Math.abs(other!.getTime() - at.getTime()) / 60_000, `${up ? 'rise' : 'set'} ${at.toISOString()}`).toBeLessThanOrEqual(5)
+        checked += 1
+      }
+    }
+    expect(checked).toBeGreaterThan(50)
+  })
+  it('sunrise and sunset, 30 days', () => {
+    for (let d = 0; d < 30; d += 1) {
+      const t = getTimes(new Date(START.getTime() + d * 86_400_000), VB.lat, VB.lon)
+      const alt = (x: Date) => sunPosition2(x, VB.lat, VB.lon).altitude
+      for (const [at, up] of [[t.sunrise, true], [t.sunset, false]] as const) {
+        if (at === null) continue
+        const other = crossing(alt, at, -0.833, up)
+        expect(Math.abs(other!.getTime() - at.getTime()) / 60_000).toBeLessThanOrEqual(5)
+      }
+    }
+  })
+})
+
+describe('the page', () => {
+  it('"Sun now · south, 34° up" at noon on 14 Nov', () => {
+    const s = sunDay(new Date('2026-11-14T17:00:00Z'), VB.lat, VB.lon, TZ)
+    expect(s.nowLine).toMatch(/^Sun now · south, 3\d° up$/)
+    expect(s.rise?.point).toMatch(/east/)
+    expect(s.set?.point).toMatch(/west/)
+    expect(s.golden.length).toBe(2)
+    expect(s.blue.length).toBe(2)
+  })
+  it('the compass words: west is west', () => {
+    expect(directionWord(270)).toBe('west')
+    expect(directionWord(0)).toBe('north')
+    expect(directionWord(247.5)).toBe('west-southwest')
+  })
+  it('the moon: 14 days of phases, a phase name, the lit part drawn on the right while waxing', () => {
+    const m = moonView(START, VB.lat, VB.lon, TZ)
+    expect(m.strip).toHaveLength(14)
+    expect(phaseName(0.5)).toBe('Full moon')
+    expect(phaseName(0.25)).toBe('First quarter')
+    expect(moonPath(60, 60, 50, 0.5, true)).toContain('A 50 50 0 0 1 60 110')
+  })
+  it('the night: the North Star due north, as high as the latitude; a next shower', () => {
+    const n = nightView(VB.lat, VB.lon, TZ, '2026-11-14')
+    expect(n.northStar).toEqual({ point: 'due north', altitude: VB.lat })
+    expect(n.shower?.name).toBe('Leonids')
+  })
+})
