+const STATE: Record<string, string> = { Virginia: 'VA', 'North Carolina': 'NC', Maryland: 'MD', 'South Carolina': 'SC', Delaware: 'DE' }
+const place = (town: string, state: string) => [town, STATE[state] ?? state].filter((x) => x !== '').join(', ')
+
