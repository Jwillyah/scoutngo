{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * src/types carries the ambient declarations for untyped dependencies. Tests in
   * tests/ import from src/, so this project compiles src files too and needs the
   * same declarations the app project has; without it, tz-lookup is untyped here
   * and only here, which `tsc -p tsconfig.app.json` will not show you.
   */
  "include": ["vite.config.ts", "netlify/functions", "tests", "src/types"]
}
